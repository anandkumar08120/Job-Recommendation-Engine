# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Persistence: "memory" (default, zero-dependency) or "postgres"
STORAGE_DRIVER=memory

# Only read when STORAGE_DRIVER=postgres
DATABASE_URL=postgres://jobmatch:jobmatch@localhost:5432/jobmatch
PGPOOL_MAX=10

# Recommendation defaults
DEFAULT_RECOMMENDATION_LIMIT=10
MAX_RECOMMENDATION_LIMIT=100
